# NetGuard FastAPI local development.
# Use a Publishable Key for read-only access to public snapshots; RLS still applies.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Required only for the protected internal snapshot-generation endpoint.
# Use a long random value and never commit the real value.
NETGUARD_COLLECTOR_TOKEN=replace_with_long_random_token

# Optional one-off local IODA collector only.
# Production data collection uses Supabase Edge Functions.
SUPABASE_SECRET_KEY=sb_secret_replace_me
IODA_BASE_URL=https://api.ioda.inetintel.cc.gatech.edu/v2
NETGUARD_COUNTRY_CODE=IR
IODA_LOOKBACK_HOURS=4
IODA_MAX_POINTS=240
IODA_TIMEOUT_SECONDS=20
