# NetGuard — local development only. Never commit real credentials.

# Read-only FastAPI access to public snapshots
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Internal endpoint authentication; long random value, trusted environments only
NETGUARD_COLLECTOR_TOKEN=replace_with_long_random_token

# Browser build-time settings; publishable key only, RLS still applies
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional one-off local IODA collector only.
# Production collectors run as Supabase Edge Functions.
SUPABASE_SECRET_KEY=sb_secret_replace_me
IODA_BASE_URL=https://api.ioda.inetintel.cc.gatech.edu/v2
NETGUARD_COUNTRY_CODE=IR
IODA_LOOKBACK_HOURS=4
IODA_MAX_POINTS=240
IODA_TIMEOUT_SECONDS=20